DB_PORT=5432
APP_PORT=8080
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ajudafio
DB_HOST=localhost
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ajudafio?sslmode=disable
DATABASE_DOCKER_URL=postgresql://postgres:postgres@postgres:5432/ajudafio?sslmode=disable

SUPABASE_ACCESS_KEY_ID=
SUPABASE_SECRET_KEY=
SUPABASE_REGION=
SUPABASE_ENDPOINT=
SUPABASE_BUCKET_NAME=
ENVIRONMENT=DEV

# Supabase Auth — the backend validates JWTs issued by Supabase Auth via JWKS (ADR-005).
# Find these in the Supabase dashboard: Project Settings → API.
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://YOUR-PROJECT.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
