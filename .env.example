DB_PORT=5432
APP_PORT=8080
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ajudafio
DB_HOST=localhost
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ajudafio?sslmode=disable
DATABASE_DOCKER_URL=postgresql://postgres:postgres@postgres:5432/ajudafio?sslmode=disable

SUPABASE_ACCESS_KEY_ID=
SUPABASE_SECRET_KEY=
SUPABASE_REGION=
SUPABASE_ENDPOINT=
SUPABASE_BUCKET_NAME=
ENVIRONMENT=DEV

# HMAC secret used to sign/validate access and refresh tokens.
# Generate with: openssl rand -base64 32
JWT_SECRET=

# OAuth Client ID used to validate "Sign in with Google" id_tokens (POST /auth/google).
# Google Cloud Console → APIs & Services → Credentials → Create Credentials → OAuth Client ID → Web application.
GOOGLE_CLIENT_ID=
